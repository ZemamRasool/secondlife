# ------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ------------------------------------------------------------------

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Database (docker-compose starts this Postgres for you)
DATABASE_URL=postgresql://secondlife:secondlife@localhost:5432/secondlife?schema=public

# Encryption key for GitHub tokens and payout details. REQUIRED. Make one with:  npm run gen:key
ENCRYPTION_KEY=

# AI: writes the plain-English summary in each project health report (optional; a template is used without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Login: firebase (real) or dev (local testing only: any email, no password; refused in production)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=

# Who can open /admin (comma-separated emails)
ADMIN_EMAILS=

# GitHub OAuth app: github.com/settings/developers → New OAuth App
#   Homepage URL: PUBLIC_BASE_URL     Callback URL: PUBLIC_BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Emails (offers, messages, deal updates): console prints them here; postmark sends them
MAIL_PROVIDER=console
POSTMARK_SERVER_TOKEN=
MAIL_FROM=SecondLife <hello@yourdomain.com>

# Escrow
#   manual    = open each deal on Escrow.com's website (as broker) and record Funded / Released in /admin
#   escrowcom = deals are created through the Escrow.com API (sandbox URL below; production is api.escrow.com)
ESCROW_PROVIDER=manual
ESCROWCOM_EMAIL=
ESCROWCOM_API_KEY=
ESCROWCOM_API_URL=https://api.escrow-sandbox.com/2017-09-01

# Business rules
COMMISSION_PERCENT=10
CONFIRM_WINDOW_DAYS=7
MIN_PRICE_USD=10
TERMS_VERSION=2026-11-06

# Uploads (screenshots)
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=5
MAX_IMAGES=8

# Run the background worker inside the web server (true), or separately with `npm run worker` (false)
WORKER_INLINE=true
